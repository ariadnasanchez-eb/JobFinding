# PostgreSQL connection string (Supabase, Neon, RDS or local).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobfinding"

# Which AI backend to use: "anthropic" (default) or "demo".
# "demo" uses keyword heuristics, needs no key, and every output is labelled as demo data.
AI_PROVIDER="anthropic"

# Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=""

# Optional overrides.
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_EFFORT="medium"   # low | medium | high

# Only for `npm run test:e2e`: a disposable database the tests can write to.
# E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jobfinding_test"
