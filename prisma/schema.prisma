generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en
  es
}

enum SubscriptionStatus {
  free
  pro
}

enum RemotePreference {
  remote
  hybrid
  onsite
  flexible
}

enum Recommendation {
  STRONGLY_APPLY
  APPLY
  APPLY_IF_INTERESTED
  LOW_PRIORITY
  DO_NOT_APPLY
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  name               String
  language           Language           @default(en)
  subscriptionStatus SubscriptionStatus @default(free)
  createdAt          DateTime           @default(now())

  sessions      Session[]
  careerProfile CareerProfile?
  resumes       Resume[]
  jobs          Job[]
}

model Session {
  id        String   @id // sha256 of the cookie token, never the raw token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  currentRole          String?
  targetRoles          String[]
  seniority            String?
  yearsExperience      Int?
  location             String?
  remotePreference     RemotePreference?
  countries            String[]
  salaryTarget         Int? // EUR per year
  salaryMinimum        Int? // EUR per year
  skills               String[]
  industries           String[]
  preferredCompanySize String?
  linkedinUrl          String?
  careerGoal           String?
  confirmedAt          DateTime? // set when the user has reviewed the extracted profile
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  mimeType      String
  fileSize      Int
  // The original file is not stored in this slice; only its extracted text.
  fileUrl       String?
  extractedText String
  parsedProfile Json?
  aiProvider    String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Job {
  id          String        @id @default(cuid())
  userId      String
  company     String?
  title       String?
  description String
  url         String?
  salary      String?
  location    String?
  parsedJob   Json?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    JobAnalysis[]

  @@index([userId, createdAt])
}

model JobAnalysis {
  id             String         @id @default(cuid())
  jobId          String
  resumeId       String?
  matchScore     Int
  breakdown      Json
  strengths      Json
  gaps           Json
  risks          Json
  recommendation Recommendation
  reasoning      String
  aiProvider     String
  createdAt      DateTime       @default(now())
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}
